# Aina-Veris environment configuration (example).
#
# This file documents the most common settings. The complete list of
# available settings — with their defaults and inline explanations — is
# declared in backend/core/config.py (the typed Settings class). Any field
# defined there can be overridden from this file or the process
# environment, even if it is not listed here.

# OPENAI API KEY
OPENAI_API_KEY=

# Gemini API Key
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Qdrant database configuration for host-side scripts and tests.
# QDRANT_HOST=
# QDRANT_PORT=
#
# Docker application override. Leave these unset to use the bundled Docker
# service. To use an existing Qdrant instance, set a hostname reachable from
# the application container and its REST port (for example, on macOS/Windows:
# DOCKER_QDRANT_HOST=host.docker.internal and DOCKER_QDRANT_PORT=6335).
# DOCKER_QDRANT_HOST=
# DOCKER_QDRANT_PORT=
# Informational only — the app builds the Qdrant URL from QDRANT_HOST/PORT
# and picks collections per domain (domain_embedding_config.yaml). These
# keys are injected into the container via env_file but not read by the app.
# QDRANT_URL=http://localhost:6335
# QDRANT_GRPC_PORT=6334
# QDRANT_COLLECTION=document-index
# EMBEDDING_SIZE=1536

# Logging levels
# DEBUG | INFO | WARNING | ERROR

LOG_LEVEL=DEBUG        # Overall app log level
LOG_CONSOLE_LEVEL=INFO   # Terminal output
LOG_FILE_LEVEL=DEBUG     # logs/server.log 
# Full prompt logs for all stages of the pipeline. Will be logged as [PROMPT_REGISTRY]
PROMPT_REGISTRY_LOG_FULL=0 # 0 for last 100 characters and 1 for full prompt

# Custom model registry configuration
# Path to custom model registry file (optional)
# If not set, uses: examples/custom_registry.py
# Example: /path/to/your/custom_models.py
CUSTOM_REGISTRY_PATH=

# Local models cache path (optional)
# If not set, defaults to ~/models/fastembed_cache
# Example: /path/to/your/models
LOCAL_MODELS_CACHE_PATH=

# Idle eviction timeout for the local ONNX embedding/reranker models
# (dense BAAI/bge-base-en-v1.5, sparse Splade_PP_en_v1), in seconds.
# These serve BOTH query-time retrieval (embedding each search query) AND
# index-time chunk embedding. Models unused for longer are released from
# memory and reloaded on next access (~1-3s).
# Example: 300 for interactive use; 0 keeps them resident on a server.
MODEL_CACHE_IDLE_TTL_SECONDS=300
# Idle eviction timeout for the INGESTION-ONLY models (Docling converter:
# layout, TableFormer, OCR, picture-description VLM), in seconds. These
# never serve queries, but the converter is expensive to rebuild (~10-60s
# of model loads), so the default is longer.
# Example: 900 for sporadic indexing; 0 keeps them resident for batch runs.
INGESTION_MODEL_CACHE_IDLE_TTL_SECONDS=900

# Public base URL advertised in the A2A agent card (read via os.getenv;
# defaults to http://localhost:8100). Set to the externally reachable URL
# when publishing the domain over A2A.
# A2A_VERIS_PUBLIC_BASE_URL=http://localhost:8100

# Origin/Host allowlists for state-changing API routes (chat, ingestion,
# registry and eval-dataset writes). Comma-separated. Browser requests must
# send a matching Origin/Referer; requests without Origin are checked against
# ALLOWED_HOSTS. These are CSRF/DNS-rebinding controls, not authentication —
# header values are client-supplied. When both are empty the check is off.
# ALLOWED_ORIGINS=http://localhost:8100,http://aina-veris:8100
# ALLOWED_HOSTS=localhost:8100,aina-veris:8100


# MCP Servers API Keys

TAVILY_API_KEY=

# Hard cap (seconds) on external MCP tool calls; timed-out calls are cancelled.
# Raise for long-running tools like tavily_research.
MCP_TOOL_TIMEOUT_SECONDS=30

# Docling PDF pipeline (POST /index-pdf-docling)
# Writes to a dedicated "<domain_collection>_docling_v1" Qdrant collection.
# PDF_DOCLING_ENABLED=true
# Pre-download Docling models in a background task after app startup
# (set false for fast cold starts; first request then pays the download cost)
# PDF_DOCLING_WARMUP_ON_STARTUP=true
# PDF_DOCLING_ARTIFACT_DIR=docling_artifacts
# PDF_DOCLING_CHUNK_SIZE=500
# PDF_DOCLING_TABLE_ROWS_PER_CHUNK=12
# Docling inference device: auto | cpu | mps | cuda | cuda:N | xpu
# PDF_DOCLING_ACCELERATOR_DEVICE=auto
# CPU threads for Docling model inference
# PDF_DOCLING_NUM_THREADS=4
# Figure captions: run detected picture regions through a captioning VLM so
# figure content becomes searchable text (adds a model download and
# per-figure inference at index time). Model: smolvlm (256M, CPU-friendly)
# or granite (granite-vision-3.3-2b, heavier but better on dense figures);
# also accepts any HuggingFace repo id (e.g. SmolVLM-500M-Instruct).
# PDF_DOCLING_PICTURE_DESCRIPTION=false
# PDF_DOCLING_PICTURE_DESCRIPTION_MODEL=smolvlm
# Base render scale for generated page/picture bitmaps (1.0 = 72 DPI).
# VLM crop resolution = this value x the preset's own 2.0 scale; set 2.0
# (~288 DPI crops) when figure micro-text (package outlines, mm callouts)
# must be legible to the caption VLM. Costs memory + VLM prefill time.
# PDF_DOCLING_IMAGES_SCALE=1.0
